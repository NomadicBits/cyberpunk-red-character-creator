<form class="cpr-chargen-form flexcol" autocomplete="off">
  <!-- HUD Header -->
  <header class="cpr-chargen-header flexrow">
    <div class="header-branding">
      <h1 class="glitch-title"><i class="fas fa-microchip"></i> CYBERPUNK RED: CHARACTER CREATOR</h1>
      <p class="subtitle">Time of the Red (2045) // {{#if (eq mode 'streetrat')}}Streetrat Mode (Fast 62-Point Preset){{else}}Edgerunner Mode (86-Point Customizer){{/if}}</p>
    </div>
    <div class="mode-toggle flexrow">
      <button type="button" class="mode-btn {{#if (eq mode 'streetrat')}}active{{/if}}" data-mode="streetrat">
        <i class="fas fa-bolt"></i> STREETRAT (Fast)
      </button>
      <button type="button" class="mode-btn {{#if (eq mode 'edgerunner')}}active{{/if}}" data-mode="edgerunner">
        <i class="fas fa-sliders-h"></i> EDGERUNNER (Custom)
      </button>
    </div>
  </header>

  <!-- AI Fast Concept Synthesizer Bar -->
  <section class="cpr-ai-concept-bar flexrow">
    <input type="text" name="aiConceptPrompt" class="concept-input" placeholder="Enter character concept (e.g. Ex-Trauma Team surgeon in debt to Maelstrom) or leave blank for random legend..." value="{{aiConceptPrompt}}"/>
    <button type="button" class="btn-ai-synthesize"><i class="fas fa-brain"></i> AI SYNTHESIZE</button>
  </section>

  <!-- Navigation Tabs -->
  <nav class="cpr-tabs tabs flexrow" data-group="primary">
    <a class="item active" data-tab="role"><i class="fas fa-user-tag"></i> 1. Role & Identity</a>
    <a class="item" data-tab="stats"><i class="fas fa-chart-bar"></i> 2. Stats & Vitals</a>
    <a class="item" data-tab="skills"><i class="fas fa-brain"></i> 3. Skills {{#if (eq mode 'edgerunner')}}({{totalSpentPoints}}/86 pts){{/if}}</a>
    <a class="item" data-tab="gear"><i class="fas fa-shield-alt"></i> 4. Gear & Chrome</a>
    <a class="item" data-tab="lifepath"><i class="fas fa-book-dead"></i> 5. Lifepath & Bio</a>
  </nav>

  <!-- Wizard Content Area -->
  <section class="cpr-tab-content">
    
    <!-- Tab 1: Role & Identity -->
    <div class="tab active" data-tab="role">
      <div class="form-group-custom">
        <label>Character Handle / Name</label>
        <input type="text" name="charName" value="{{charName}}" placeholder="e.g. V, Johnny Silverhand, Deacon, Ghost"/>
      </div>

      <div class="roles-grid">
        {{#each roles as |r key|}}
        <div class="role-card {{#if (eq ../selectedRole key)}}selected{{/if}}" data-role="{{key}}">
          <h3>{{r.name}}</h3>
          <span class="role-ability"><i class="fas fa-bolt"></i> {{r.ability}}</span>
          <p>{{r.tagline}}</p>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Tab 2: Stats & Vitals -->
    <div class="tab" data-tab="stats">
      <div class="stat-template-selector flexrow">
        <label>Stat Array (1-10 Roll / Template):</label>
        <select name="statTemplateIndex" class="stat-select">
          {{#each currentRoleDef.statTemplates as |st idx|}}
          <option value="{{idx}}" {{#if (eq ../selectedTemplateIndex idx)}}selected{{/if}}>Template {{add idx 1}} (REF {{st.ref}}, DEX {{st.dex}}, BODY {{st.body}}, INT {{st.int}}, TECH {{st.tech}}, WILL {{st.will}})</option>
          {{/each}}
        </select>
        <button type="button" class="btn-roll-stats"><i class="fas fa-dice-d10"></i> Roll 1d10 Array</button>
      </div>

      <div class="stats-matrix grid-5">
        <div class="stat-box"><span>INT</span><strong>{{currentStats.int}}</strong></div>
        <div class="stat-box"><span>REF</span><strong>{{currentStats.ref}}</strong></div>
        <div class="stat-box"><span>DEX</span><strong>{{currentStats.dex}}</strong></div>
        <div class="stat-box"><span>TECH</span><strong>{{currentStats.tech}}</strong></div>
        <div class="stat-box"><span>COOL</span><strong>{{currentStats.cool}}</strong></div>
        <div class="stat-box"><span>WILL</span><strong>{{currentStats.will}}</strong></div>
        <div class="stat-box"><span>LUCK</span><strong>{{currentStats.luck}}</strong></div>
        <div class="stat-box"><span>MOVE</span><strong>{{currentStats.move}}</strong></div>
        <div class="stat-box"><span>BODY</span><strong>{{currentStats.body}}</strong></div>
        <div class="stat-box"><span>EMP</span><strong>{{currentStats.emp}}</strong></div>
      </div>

      <div class="derived-stats-bar flexrow">
        <div class="derived-badge"><i class="fas fa-heart"></i> Hit Points: <strong>{{derived.hp}}</strong></div>
        <div class="derived-badge"><i class="fas fa-skull"></i> Seriously Wounded: <strong>{{derived.wounded}}</strong></div>
        <div class="derived-badge"><i class="fas fa-crosshairs"></i> Death Save: <strong>{{currentStats.body}}</strong></div>
        <div class="derived-badge"><i class="fas fa-smile"></i> Humanity: <strong>{{derived.humanity}}</strong></div>
      </div>
    </div>

    <!-- Tab 3: Skills Allocation -->
    <div class="tab" data-tab="skills">
      <div class="skills-header-bar flexrow">
        {{#if (eq mode 'edgerunner')}}
        <div class="budget-badge {{#if (gt totalSpentPoints 86)}}over{{else if (eq totalSpentPoints 86)}}exact{{else}}under{{/if}}">
          <i class="fas fa-calculator"></i> Skill Points Budget: <strong>{{totalSpentPoints}} / 86</strong>
        </div>
        <button type="button" class="btn-reset-skills"><i class="fas fa-undo"></i> Reset to Role Template</button>
        {{else}}
        <div class="streetrat-skill-info">
          <i class="fas fa-info-circle"></i> <strong>Streetrat Mode:</strong> Skills are pre-allocated according to standard template packages. Switch to <strong>Edgerunner</strong> to customize points.
        </div>
        {{/if}}
      </div>

      <div class="skills-grid-container">
        {{#each currentSkills as |val key|}}
        <div class="skill-row flexrow">
          <span class="skill-name">{{key}}</span>
          <div class="skill-controls flexrow">
            {{#if (eq ../mode 'edgerunner')}}
            <button type="button" class="btn-skill-dec" data-skill="{{key}}"><i class="fas fa-minus"></i></button>
            <span class="skill-value">{{val}}</span>
            <button type="button" class="btn-skill-inc" data-skill="{{key}}"><i class="fas fa-plus"></i></button>
            {{else}}
            <span class="skill-value static">{{val}}</span>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- Tab 4: Gear & Chrome (Choice Loadouts) -->
    <div class="tab" data-tab="gear">
      <div class="gear-overview-grid flexrow">
        
        <!-- Left Column: Weapons & Armor -->
        <div class="gear-column">
          <h3><i class="fas fa-gun"></i> Weapon Loadout (Select Options)</h3>
          {{#each currentRoleDef.weaponChoices as |wc|}}
          <div class="choice-group">
            <label class="choice-label"><i class="fas fa-crosshairs"></i> {{wc.label}}:</label>
            <select name="weaponChoice_{{wc.id}}" class="gear-select" data-choice-type="weapon" data-choice-id="{{wc.id}}">
              {{#each wc.options as |opt|}}
              <option value="{{opt}}">{{opt}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}

          <h3 style="margin-top:14px;"><i class="fas fa-shield-alt"></i> Starting Armor</h3>
          <p class="armor-badge"><i class="fas fa-check-circle"></i> {{currentRoleDef.armor}}</p>

          {{#if currentRoleDef.vehicleChoices}}
          <h3 style="margin-top:14px;"><i class="fas fa-car"></i> Clan Vehicle Choice</h3>
          {{#each currentRoleDef.vehicleChoices as |vc|}}
          <div class="choice-group">
            <label class="choice-label">{{vc.label}}:</label>
            <select name="vehicleChoice_{{vc.id}}" class="gear-select" data-choice-type="vehicle" data-choice-id="{{vc.id}}">
              {{#each vc.options as |opt|}}
              <option value="{{opt}}">{{opt}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
          {{/if}}

          {{#if currentRoleDef.corpPerkChoices}}
          <h3 style="margin-top:14px;"><i class="fas fa-building"></i> Corporate Asset</h3>
          {{#each currentRoleDef.corpPerkChoices as |cpc|}}
          <div class="choice-group">
            <label class="choice-label">{{cpc.label}}:</label>
            <select name="corpPerkChoice_{{cpc.id}}" class="gear-select" data-choice-type="corpPerk" data-choice-id="{{cpc.id}}">
              {{#each cpc.options as |opt|}}
              <option value="{{opt}}">{{opt}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
          {{/if}}

          {{#if currentRoleDef.instrumentChoices}}
          <h3 style="margin-top:14px;"><i class="fas fa-guitar"></i> Signature Instrument</h3>
          {{#each currentRoleDef.instrumentChoices as |ic|}}
          <div class="choice-group">
            <label class="choice-label">{{ic.label}}:</label>
            <select name="instrumentChoice_{{ic.id}}" class="gear-select" data-choice-type="instrument" data-choice-id="{{ic.id}}">
              {{#each ic.options as |opt|}}
              <option value="{{opt}}">{{opt}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
          {{/if}}
        </div>

        <!-- Right Column: Cyberware & Pack Gear -->
        <div class="gear-column">
          <h3><i class="fas fa-microchip"></i> Cyberware Augmentations</h3>
          
          {{#if currentRoleDef.baseCyberware.length}}
          <div class="base-cyber-list">
            <span class="sub-label">Standard Pre-Installed:</span>
            <ul>
              {{#each currentRoleDef.baseCyberware as |bc|}}
              <li><i class="fas fa-check"></i> {{bc}}</li>
              {{/each}}
            </ul>
          </div>
          {{/if}}

          {{#each currentRoleDef.cyberwareChoices as |cc|}}
          <div class="choice-group" style="margin-top:8px;">
            <label class="choice-label"><i class="fas fa-bolt"></i> {{cc.label}}:</label>
            <select name="cyberwareChoice_{{cc.id}}" class="gear-select" data-choice-type="cyberware" data-choice-id="{{cc.id}}">
              {{#each cc.options as |opt|}}
              <option value="{{opt}}">{{opt}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}

          {{#if currentRoleDef.deckPrograms}}
          <h3 style="margin-top:14px;"><i class="fas fa-terminal"></i> Starting Cyberdeck Programs</h3>
          <ul class="programs-list">
            {{#each currentRoleDef.deckPrograms as |p|}}
            <li><i class="fas fa-code"></i> {{p}}</li>
            {{/each}}
          </ul>
          {{/if}}

          <h3 style="margin-top:14px;"><i class="fas fa-box"></i> Starting Pack & Cash</h3>
          <ul>
            {{#each currentRoleDef.gear as |g|}}
            <li>{{g}}</li>
            {{/each}}
          </ul>
        </div>

      </div>
    </div>

    <!-- Tab 5: Lifepath & Bio -->
    <div class="tab" data-tab="lifepath">
      <div class="lifepath-actions flexrow">
        <button type="button" class="btn-roll-lifepath"><i class="fas fa-dice"></i> Roll Full Random Lifepath</button>
        <button type="button" class="btn-ai-weave-bio"><i class="fas fa-pen-nib"></i> AI Weave Backstory</button>
      </div>

      <div class="lifepath-grid">
        <div class="lifepath-item"><label>Cultural Origin:</label><input type="text" name="lp_culturalOrigin" value="{{lifepath.culturalOrigin}}"/></div>
        <div class="lifepath-item"><label>Personality:</label><input type="text" name="lp_personality" value="{{lifepath.personality}}"/></div>
        <div class="lifepath-item"><label>Dress & Style:</label><input type="text" name="lp_clothingStyle" value="{{lifepath.clothingStyle}}"/></div>
        <div class="lifepath-item"><label>Hairstyle:</label><input type="text" name="lp_hairStyle" value="{{lifepath.hairStyle}}"/></div>
        <div class="lifepath-item"><label>Affectation:</label><input type="text" name="lp_affectation" value="{{lifepath.affectation}}"/></div>
        <div class="lifepath-item"><label>Family Background:</label><input type="text" name="lp_familyBackground" value="{{lifepath.familyBackground}}"/></div>
        <div class="lifepath-item"><label>Family Crisis:</label><input type="text" name="lp_familyCrisis" value="{{lifepath.familyCrisis}}"/></div>
        <div class="lifepath-item"><label>Life Goal:</label><input type="text" name="lp_lifeGoals" value="{{lifepath.lifeGoals}}"/></div>
        <div class="lifepath-item"><label>Friend:</label><input type="text" name="lp_friend" value="{{lifepath.friendText}}"/></div>
        <div class="lifepath-item"><label>Enemy:</label><input type="text" name="lp_enemy" value="{{lifepath.enemyText}}"/></div>
        <div class="lifepath-item"><label>Tragic Love Affair:</label><input type="text" name="lp_tragicLove" value="{{lifepath.tragicLove}}"/></div>
      </div>

      <div class="backstory-box">
        <label><i class="fas fa-scroll"></i> Character History & Backstory</label>
        <textarea name="backstory" rows="6">{{backstory}}</textarea>
      </div>
    </div>

  </section>

  <!-- Footer Actions -->
  <footer class="cpr-chargen-footer flexrow">
    <button type="button" class="btn-cancel"><i class="fas fa-times"></i> Cancel</button>
    <button type="submit" class="btn-create-actor"><i class="fas fa-user-plus"></i> CREATE CHARACTER IN WORLD</button>
  </footer>
</form>
